<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.social</groupId>
  <artifactId>uterspace</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>uterspace Maven Webapp</name>
  <!-- FIXME change it to the project's website -->
  <url>http://www.example.com</url>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>
  <dependencies>
    <!-- Servlet API (provided by Tomcat 9) -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- JSTL -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>jstl</artifactId>
      <version>1.2</version>
    </dependency>
    <!-- JSP API (provided by Tomcat) -->
    <dependency>
      <groupId>javax.servlet.jsp</groupId>
      <artifactId>javax.servlet.jsp-api</artifactId>
      <version>2.3.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- WebSocket API JSR 356 (provided by Tomcat) â€” nháº¯n tin / thÃ´ng bÃ¡o thá»i gian thá»±c -->
    <dependency>
      <groupId>javax.websocket</groupId>
      <artifactId>javax.websocket-api</artifactId>
      <version>1.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- JavaMail â€” gá»­i email mÃ£ OTP quÃªn máº­t kháº©u (Tomcat 9 khÃ´ng cÃ³ sáºµn â†’ Ä‘Ã³ng gÃ³i vÃ o WAR) -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>javax.mail</artifactId>
      <version>1.6.2</version>
      <exclusions>
        <!-- thay activation 1.1 cÅ© báº±ng báº£n 1.2.0 Ä‘áº§y Ä‘á»§ bÃªn dÆ°á»›i (cÃ¹ng phiÃªn báº£n javax.activation-api mÃ  Hibernate kÃ©o vÃ o) -->
        <exclusion>
          <groupId>javax.activation</groupId>
          <artifactId>activation</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- JavaBeans Activation (báº£n cÃ i Ä‘áº·t, khÃ´ng chá»‰ API) â€” JavaMail cáº§n Ä‘á»ƒ dá»±ng email nhiá»u pháº§n; JDK 11+ Ä‘Ã£ bá» khá»i Java -->
    <dependency>
      <groupId>com.sun.activation</groupId>
      <artifactId>javax.activation</artifactId>
      <version>1.2.0</version>
    </dependency>
    <!-- JUnit -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <!-- MySQL Connector/J — DB cloud MySQL 8 trên Aiven (trước đây: mssql-jdbc cho SQL Server SmarterASP) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.3.0</version>
      <exclusions>
        <!-- protobuf chỉ dùng cho X DevAPI (cổng 33060), app dùng giao thức MySQL thường -->
        <exclusion>
          <groupId>com.google.protobuf</groupId>
          <artifactId>protobuf-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Hibernate Core for JPA -->
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>5.6.15.Final</version>
    </dependency>
    <!-- Anthropic Claude API (SDK chÃ­nh thá»©c) â€” dÃ¹ng khi key lÃ  "sk-ant-..."; key Google dÃ¹ng GeminiClient (REST).
         ChÆ°a cáº¥u hÃ¬nh API key thÃ¬ app tá»± dÃ¹ng thuáº­t toÃ¡n offline (xem com.uterspace.ai.AiConfig). -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.34.0</version>
    </dependency>
    <!-- Jackson â€” Ä‘á»c / ghi JSON khi gá»i Google Gemini REST API (GeminiClient) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <!-- BCrypt cho mÃƒÂ£ hÃƒÂ³a mÃ¡ÂºÂ­t khÃ¡ÂºÂ©u -->
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>0.10.2</version>
    </dependency>
    <!-- Pool kết nối HikariCP thay pool có sẵn của Hibernate ("not for production"): DB cloud ở Mỹ ~200 ms / lượt,
         pool cũ tốn thêm 2 lượt mạng mỗi lần mượn / trả kết nối và mở kết nối mới (~1,4 giây) giữa lúc người dùng chờ -->
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-hikaricp</artifactId>
      <version>5.6.15.Final</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>4.0.3</version>
    </dependency>
    <!-- Log của HikariCP (lỗi kết nối DB...) đi qua SLF4J → java.util.logging → log Tomcat.
         Ghim bản ổn định thay slf4j-api 2.0.0-alpha1 mà HikariCP 4.0.3 kéo theo -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>1.7.36</version>
    </dependency>
      <!-- Cloudinary -->
    <dependency>
      <groupId>com.cloudinary</groupId>
      <artifactId>cloudinary-http44</artifactId>
      <version>1.36.0</version>
    </dependency>
  </dependencies>
  <build>
    <finalName>uterspace</finalName>
    <pluginManagement>
      <!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <!-- see http://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_war_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.2.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>2.5.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>2.8.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
