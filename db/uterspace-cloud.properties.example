# ============================================================
# UTErSpace — tài khoản Cloud: MySQL (Aiven) + Cloudinary (ảnh / video)
#
# CÁCH DÙNG: chép file này thành  <thư mục Tomcat>/conf/uterspace-cloud.properties
#            (vd: C:\ApacheTomcat\conf\uterspace-cloud.properties — BỎ đuôi .example),
#            điền giá trị lấy từ docs/CLOUD_CREDENTIALS.md (nhóm gửi riêng, không có trên GitHub) rồi
#            KHỞI ĐỘNG LẠI Tomcat.
# File thật nằm NGOÀI project → không bị commit. KHÔNG ghi mật khẩu / API secret vào code.
#
# Thay thế bằng biến môi trường (ưu tiên hơn file):
#   UTERSPACE_DB_USER, UTERSPACE_DB_PASSWORD, UTERSPACE_DB_URL, UTERSPACE_DB_POOL_SIZE
#   CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Thiếu tài khoản DB → app không khởi động, log Tomcat ghi rõ "[JPAUtil] Chưa cấu hình tài khoản database...".
# Thiếu Cloudinary   → app vẫn chạy nhưng không đăng được ảnh / video ("[Cloudinary] Chưa cấu hình...").
# ============================================================

# ---------- MySQL cloud trên Aiven (bắt buộc) ----------
db.user=
db.password=

# Đổi DB (vd: MySQL trên máy mình). Bỏ trống = DB cloud Aiven ghi trong persistence.xml
# db.url=jdbc:mysql://localhost:3306/uterspace?characterEncoding=UTF-8&connectionTimeZone=Asia/Ho_Chi_Minh&forceConnectionTimeZoneToSession=true
# Số kết nối tối đa (gói Aiven giới hạn số kết nối đồng thời). Mặc định 10
# db.poolSize=5

# ---------- Cloudinary (ảnh, video, mô hình 3D) ----------
cloudinary.cloudName=
cloudinary.apiKey=
cloudinary.apiSecret=
